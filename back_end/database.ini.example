; Copie este arquivo para database.ini (gitignored) e ajuste se necessário.
; Usado quando o back-end roda FORA do Docker (ex: debug local no VS Code),
; conectando ao Postgres pela porta publicada em localhost:5434.
; Porta 5434 (e não 5432/5433) de propósito: evita colisão com um Postgres
; local já instalado na sua máquina.

[link_shortener]
host = localhost
port = 5434
dbname = link_shortener
user = postgres
password = postgres
